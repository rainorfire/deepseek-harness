{
  "name": "@dazi/dsh-dazi-bot",
  "description": "dazi-bot bundle: registers the connectors installed for WorkDazi as MCP servers in a dsh profile",
  "version": "0.2.2-rc.1-dazi.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "connectors.js",
    "connectors.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown --config-loader native"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-mcp-manager": "workspace:*"
  }
}
